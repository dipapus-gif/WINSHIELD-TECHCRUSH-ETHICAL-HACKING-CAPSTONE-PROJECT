<Window x:Class="WinShield.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinShield: Anti-Ransomware Protection" Icon="/winshield.ico"
        Width="1200" Height="800" MinWidth="960" MinHeight="620"
        Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        PreviewKeyDown="OnKey" StateChanged="OnStateChanged">

    <Grid x:Name="Root" Margin="16">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Brand and account bar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <Border DockPanel.Dock="Left" CornerRadius="8" Padding="10,5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0A0A0C" Offset="0" />
                        <GradientStop Color="#3A2E06" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Assets/logo.png" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="WinShield" Foreground="#FFC933" FontWeight="Bold" FontSize="15" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
            <Button x:Name="MinBtn" DockPanel.Dock="Right" Content="&#8212;  Minimize" Click="OnMinimize" Style="{StaticResource ActionButton}" Margin="6,0,0,0" ToolTip="Minimize to the taskbar" />
            <Button x:Name="MaxBtn" DockPanel.Dock="Right" Content="&#9633;  Maximize" Click="OnMaximize" Style="{StaticResource ActionButton}" Margin="6,0,0,0" ToolTip="Enlarge the window to fill the screen" />
            <Button x:Name="FullBtn" DockPanel.Dock="Right" Content="&#9974;  Full screen" Click="OnFullScreen" Style="{StaticResource ActionButton}" Margin="6,0,0,0" ToolTip="Full screen (F11)" />
            <Button DockPanel.Dock="Right" Content="A+" Click="OnZoomIn" Style="{StaticResource ActionButton}" Margin="6,0,0,0" ToolTip="Make everything larger (Ctrl and +)" />
            <Button DockPanel.Dock="Right" Content="A&#8722;" Click="OnZoomOut" Style="{StaticResource ActionButton}" Margin="6,0,0,0" ToolTip="Make everything smaller (Ctrl and -)" />
            <Button x:Name="ThemeBtn" DockPanel.Dock="Right" Click="OnToggleTheme" Style="{StaticResource ActionButton}" Margin="10,0,0,0" ToolTip="Switch between light and dark mode" />
            <Button DockPanel.Dock="Right" Content="Sign out" Click="OnSignOut" Style="{StaticResource ActionButton}" Margin="10,0,0,0" />
            <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}">
                <Run Text="Signed in as " /><Run x:Name="UserText" FontWeight="SemiBold" />
            </TextBlock>
            <Border />
        </DockPanel>

        <TabControl Grid.Row="1" BorderThickness="0" Background="Transparent">

            <!-- ============================== DASHBOARD ============================== -->
            <TabItem Header="Dashboard" Padding="14,6">
                <Grid DataContext="{Binding Dashboard}" Margin="0,14,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Protection status banner: grey = off, green = protected, red = emergency -->
                    <Border Grid.Row="0" Padding="20" CornerRadius="10">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource OffBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SafeBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Emergency}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding StatusTitle}" FontSize="24" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="{Binding StatusDetail}" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding NetworkText}" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding AdminText}" Foreground="White" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                                <Button Content="{Binding ToggleText}" Command="{Binding ToggleProtectionCommand}"
                                        Style="{StaticResource ActionButton}" MinWidth="190" FontWeight="SemiBold" />
                                <Button Content="{Binding EmergencyText}" Command="{Binding EmergencyCommand}"
                                        Style="{StaticResource ActionButton}" MinWidth="190" FontWeight="SemiBold" />
                                <Button Content="Resume suspended programs" Command="{Binding ResumeAllCommand}"
                                        Style="{StaticResource ActionButton}" MinWidth="190" />
                                <Button Content="Restart as administrator" Command="{Binding RestartAsAdminCommand}"
                                        Style="{StaticResource ActionButton}" MinWidth="190"
                                        Visibility="{Binding Administrator, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="1" Text="{Binding Message}" Style="{StaticResource Hint}" Margin="4,8,4,4" FontWeight="SemiBold" />

                    <!-- Live detection window -->
                    <UniformGrid Grid.Row="2" Columns="6" Margin="0,6,0,0">
                        <Border Style="{StaticResource Tile1}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="{Binding ThreatLevel}" Style="{StaticResource TileValue}"
                                           Foreground="{Binding ThreatLevel, Converter={StaticResource SeverityToBrush}}" />
                                <TextBlock Text="Threat level" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile2}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="{Binding ThreatScore, StringFormat={}{0:0}}" Style="{StaticResource TileValue}" Foreground="{DynamicResource Tile2}"  />
                                <TextBlock Text="Threat score (0-100)" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile3}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Modified}" Style="{StaticResource TileValue}" Foreground="{DynamicResource Tile3}"  />
                                <TextBlock Text="Files changed (live window)" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile4}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Renamed}" Style="{StaticResource TileValue}" Foreground="{DynamicResource Tile4}"  />
                                <TextBlock Text="Files renamed" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile5}" Margin="0,0,8,8">
                            <StackPanel>
                                <TextBlock Text="{Binding Deleted}" Style="{StaticResource TileValue}" Foreground="{DynamicResource Tile5}"  />
                                <TextBlock Text="Files deleted" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile6}" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="{Binding HighEntropy}" Style="{StaticResource TileValue}" Foreground="{DynamicResource Tile6}"  />
                                <TextBlock Text="Possibly encrypted" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Incident statistics -->
                    <UniformGrid Grid.Row="3" Columns="5">
                        <Border Style="{StaticResource Tile1}" Margin="0,0,8,12" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{Binding TotalIncidents}" Style="{StaticResource TileValue}" FontSize="20" Foreground="{DynamicResource Tile1}"  />
                                <TextBlock Text="Incidents recorded" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile4}" Margin="0,0,8,12" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{Binding OpenIncidents}" Style="{StaticResource TileValue}" FontSize="20" Foreground="{DynamicResource Tile4}"  />
                                <TextBlock Text="Still open" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile5}" Margin="0,0,8,12" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{Binding Critical30d}" Style="{StaticResource TileValue}" FontSize="20" Foreground="{DynamicResource Tile5}"  />
                                <TextBlock Text="Critical (30 days)" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile2}" Margin="0,0,8,12" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{Binding High30d}" Style="{StaticResource TileValue}" FontSize="20" Foreground="{DynamicResource Tile2}"  />
                                <TextBlock Text="High (30 days)" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Tile3}" Margin="0,0,0,12" Padding="14,10">
                            <StackPanel>
                                <TextBlock Text="{Binding FileEvents24h}" Style="{StaticResource TileValue}" FontSize="20" Foreground="{DynamicResource Tile3}"  />
                                <TextBlock Text="File events (24 h)" Style="{StaticResource TileLabel}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Suspicious processes | recent incidents | live file activity -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Suspicious programs" Style="{StaticResource SectionTitle}" />
                                <DataGrid ItemsSource="{Binding Processes}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Program" Binding="{Binding Name}" Width="*" />
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="55" />
                                        <DataGridTextColumn Header="Writes" Binding="{Binding WriteText}" Width="75" />
                                        <DataGridTextColumn Header="Score" Binding="{Binding Score, StringFormat={}{0:0}}" Width="50" />
                                        <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="75" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Recent incidents" Style="{StaticResource SectionTitle}" />
                                <DataGrid ItemsSource="{Binding RecentIncidents}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding TimeLocal, StringFormat=t}" Width="70" />
                                        <DataGridTemplateColumn Header="Severity" Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="What happened" Binding="{Binding Title}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="4" Style="{StaticResource Card}" Padding="12">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Top" Text="Live file activity" Style="{StaticResource SectionTitle}" />
                                <DataGrid ItemsSource="{Binding LiveActivity}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal, StringFormat=T}" Width="70" />
                                        <DataGridTextColumn Header="Event" Binding="{Binding KindText}" Width="95" />
                                        <DataGridTextColumn Header="File" Binding="{Binding FileName}" Width="*" />
                                        <DataGridTextColumn Header="Entropy" Binding="{Binding EntropyText}" Width="55" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ============================== INCIDENTS ============================== -->
            <TabItem Header="Incidents" Padding="14,6">
                <Grid DataContext="{Binding Incidents}" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="1.1*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DataGrid Grid.Row="0" ItemsSource="{Binding Incidents}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Binding="{Binding TimeLocal, StringFormat=g}" Width="125" />
                                    <DataGridTemplateColumn Header="Severity" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Severity}" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="What happened" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Grid.Row="1" Margin="12,12,12,4">
                                <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource ActionButton}" />
                                <Button Content="Save report (HTML)" Command="{Binding ExportHtmlCommand}" Style="{StaticResource ActionButton}" />
                                <Button Content="Save report (CSV)" Command="{Binding ExportCsvCommand}" Style="{StaticResource ActionButton}" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <TextBlock Text="Select an incident on the left to see what happened and what you can do about it."
                                       Style="{StaticResource Hint}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />

                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Selected.Title}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Hint}">
                                        <Run Text="{Binding Selected.Severity, Mode=OneWay}" FontWeight="SemiBold" />
                                        <Run Text=" | score " /><Run Text="{Binding Selected.Score, Mode=OneWay, StringFormat={}{0:0}}" />
                                        <Run Text=" | status " /><Run Text="{Binding Selected.Status, Mode=OneWay}" />
                                        <Run Text=" | program " /><Run Text="{Binding Selected.ProcessText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Selected.Description}" TextWrapping="Wrap" Margin="0,10,0,0" />

                                    <TextBlock Text="What you can do" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                                    <WrapPanel>
                                        <Button Content="Suspend program" Command="{Binding SuspendCommand}" Style="{StaticResource ActionButton}" />
                                        <Button Content="Resume program" Command="{Binding ResumeCommand}" Style="{StaticResource ActionButton}" />
                                        <Button Content="Terminate program" Command="{Binding KillCommand}" Style="{StaticResource ActionButton}" />
                                        <Button Content="Quarantine program file" Command="{Binding QuarantineCommand}" Style="{StaticResource ActionButton}" />
                                        <Button Content="Cut off network" Command="{Binding IsolateCommand}" Style="{StaticResource ActionButton}" />
                                        <Button Content="Restore network" Command="{Binding RestoreNetworkCommand}" Style="{StaticResource ActionButton}" />
                                        <Button Content="Open evidence folder" Command="{Binding OpenEvidenceCommand}" Style="{StaticResource ActionButton}" />
                                        <Button Content="Mark resolved" Command="{Binding ResolveCommand}" Style="{StaticResource ActionButton}" />
                                        <Button Content="Mark false positive" Command="{Binding FalsePositiveCommand}" Style="{StaticResource ActionButton}" />
                                        <Button Content="Always trust this program" Command="{Binding TrustCommand}" Style="{StaticResource ActionButton}" />
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Message}" Style="{StaticResource Hint}" FontWeight="SemiBold" />

                                    <TextBlock Text="Actions taken" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                                    <DataGrid ItemsSource="{Binding Actions}" MaxHeight="170" Background="{DynamicResource GridBackground}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Time" Binding="{Binding TimeLocal, StringFormat=T}" Width="75" />
                                            <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="150" />
                                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="60" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <TextBlock Text="Affected files" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                                    <ListBox ItemsSource="{Binding AffectedFiles}" MaxHeight="150" BorderThickness="0" Background="{DynamicResource GridBackground}" />

                                    <TextBlock Text="Recommendations" Style="{StaticResource SectionTitle}" Margin="0,16,0,6" />
                                    <ItemsControl ItemsSource="{Binding Recommendations}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ======================= FOLDERS, DECOYS, INTEGRITY ======================= -->
            <TabItem Header="Folders and integrity" Padding="14,6">
                <ScrollViewer DataContext="{Binding Folders}" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Protected folders" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="WinShield watches these folders for ransomware-like activity. Adding or removing a folder restarts protection automatically." />
                                <ListBox ItemsSource="{Binding ProtectedFolders}" SelectedItem="{Binding SelectedFolder, Mode=TwoWay}"
                                         MinHeight="70" MaxHeight="140" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Content="Add folder..." Command="{Binding AddFolderCommand}" Style="{StaticResource ActionButton}" />
                                    <Button Content="Remove selected" Command="{Binding RemoveFolderCommand}" Style="{StaticResource ActionButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Lock down protected folders (Controlled Folder Access)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="Uses Windows Defender to stop programs it does not trust from changing files in the protected folders. WinShield also turns this on automatically during emergency protection." />
                                <TextBlock FontWeight="SemiBold" Margin="0,0,0,8">
                                    <Run Text="Status: " />
                                    <Run Text="{Binding CfaStatus, Mode=OneWay}" />
                                </TextBlock>
                                <WrapPanel>
                                    <Button Content="Turn on" Command="{Binding EnableCfaCommand}" Style="{StaticResource ActionButton}" />
                                    <Button Content="Turn off" Command="{Binding DisableCfaCommand}" Style="{StaticResource ActionButton}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Decoy files (honeypots)" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                                           Text="Hidden bait files placed in each protected folder. Nothing legitimate should ever change them, so if one is modified, renamed or deleted WinShield raises an immediate alert and records which program did it." />
                                <WrapPanel>
                                    <Button Content="Place decoy files" Command="{Binding DeployDecoysCommand}" Style="{StaticResource ActionButton}" />
                                    <Button Content="Remove decoy files" Command="{Binding RemoveDecoysCommand}" Style="{StaticResource ActionButton}" />
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding Decoys}" MaxHeight="170" Background="{DynamicResource GridBackground}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="110" />
                                        <DataGridTextColumn Header="Decoy file" Binding="{Binding FilePath}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="File integrity" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding BaselineText}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8"
                                           Text="Record a fingerprint (SHA-256 hash) of every file while you know they are clean, then compare later to see exactly which files were changed, deleted, renamed or added." />
                                <WrapPanel>
                                    <Button Content="Build baseline" Command="{Binding BuildBaselineCommand}" Style="{StaticResource ActionButton}" />
                                    <Button Content="Compare with baseline" Command="{Binding CompareCommand}" Style="{StaticResource ActionButton}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Hint}" />
                                <TextBlock Text="{Binding IntegritySummary}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <DataGrid ItemsSource="{Binding Changes}" MaxHeight="260" Background="{DynamicResource GridBackground}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Change" Binding="{Binding Kind}" Width="85" />
                                        <DataGridTextColumn Header="File" Binding="{Binding FilePath}" Width="*" />
                                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding Message}" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="4,0,0,8" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ RECOVERY ============================ -->
            <TabItem Header="Recovery" Padding="14,6">
                <ScrollViewer DataContext="{Binding Recovery}" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Recovery points" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,8"
                                           Text="Protected copies of your files. Every restored file is checked against its recorded hash. Keep another backup on a separate drive or account too." />
                                <WrapPanel>
                                    <Button Content="Create recovery point" Command="{Binding CreatePointCommand}" Style="{StaticResource ActionButton}" />
                                    <Button Content="Verify selected" Command="{Binding VerifyCommand}" Style="{StaticResource ActionButton}" />
                                    <Button Content="Restore to a folder..." Command="{Binding RestoreToFolderCommand}" Style="{StaticResource ActionButton}" />
                                    <Button Content="Restore over originals..." Command="{Binding RestoreInPlaceCommand}" Style="{StaticResource ActionButton}" />
                                    <Button Content="Clean up old points" Command="{Binding PruneCommand}" Style="{StaticResource ActionButton}" />
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding Points}" SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                                          MaxHeight="220" Background="{DynamicResource GridBackground}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Created" Binding="{Binding CreatedLocal, StringFormat=g}" Width="130" />
                                        <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*" />
                                        <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="70" />
                                        <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                                        <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="170" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Quarantined files" Style="{StaticResource SectionTitle}" />
                                <WrapPanel>
                                    <Button Content="Restore selected" Command="{Binding RestoreQuarantinedCommand}" Style="{StaticResource ActionButton}" />
                                    <Button Content="Delete selected" Command="{Binding DeleteQuarantinedCommand}" Style="{StaticResource ActionButton}" />
                                </WrapPanel>
                                <DataGrid ItemsSource="{Binding Quarantined}" SelectedItem="{Binding SelectedQuarantine, Mode=TwoWay}"
                                          MaxHeight="200" Background="{DynamicResource GridBackground}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When" Binding="{Binding TimeLocal, StringFormat=g}" Width="130" />
                                        <DataGridTextColumn Header="Original location" Binding="{Binding OriginalPath}" Width="*" />
                                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*" />
                                        <DataGridTextColumn Header="State" Binding="{Binding StateText}" Width="100" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="If you have been hit by ransomware" Style="{StaticResource SectionTitle}" />
                                <ItemsControl ItemsSource="{Binding Guidance}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ SYSTEM HEALTH ============================ -->
            <TabItem Header="System health" Padding="14,6">
                <TabControl DataContext="{Binding SystemHealth}" BorderThickness="0" Background="Transparent" Margin="0,8,0,0">
                    <TabItem Header="Scan" Padding="12,5">
                        <Grid Margin="0,14,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Style="{StaticResource Card}" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Score}" FontSize="56" FontWeight="Bold"
                                                   Foreground="{Binding Score, Converter={StaticResource ScoreToBrush}}" />
                                        <TextBlock Text="/100" FontSize="18" Foreground="{DynamicResource MutedText}"
                                                   VerticalAlignment="Bottom" Margin="4,0,0,12" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="20" FontWeight="SemiBold">
                                            <Run Text="Security grade: " /><Run Text="{Binding Grade, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Content="Run scan" Command="{Binding ScanCommand}"
                                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                                <ListView ItemsSource="{Binding Results}" BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="14,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0" CornerRadius="10" Height="22" Width="72"
                                                        HorizontalAlignment="Left" VerticalAlignment="Top"
                                                        Background="{Binding Status, Converter={StaticResource StatusToBrush}}">
                                                    <TextBlock Text="{Binding Status}" Foreground="White"
                                                               FontSize="11" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" />
                                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource MutedText}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Scan history" Padding="12,5">
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="360" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <DataGrid Grid.Row="0" ItemsSource="{Binding History}"
                                              SelectedItem="{Binding SelectedScan, Mode=TwoWay}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="When" Width="*" Binding="{Binding StartedLocal, StringFormat=g}" />
                                            <DataGridTextColumn Header="Score" Width="60" Binding="{Binding Score}" />
                                            <DataGridTextColumn Header="Pass" Width="50" Binding="{Binding PassCount}" />
                                            <DataGridTextColumn Header="Warn" Width="50" Binding="{Binding WarnCount}" />
                                            <DataGridTextColumn Header="Fail" Width="50" Binding="{Binding FailCount}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <Button Grid.Row="1" Content="Delete selected scan" Margin="12"
                                            Command="{Binding DeleteScanCommand}" Padding="10,6" />
                                </Grid>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                                <DataGrid ItemsSource="{Binding HistoryResults}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Status" Width="80" Binding="{Binding Status}" />
                                        <DataGridTextColumn Header="Check" Width="200" Binding="{Binding Title}" />
                                        <DataGridTextColumn Header="Detail" Width="*" Binding="{Binding Detail}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>

            <!-- ============================== SETTINGS ============================== -->
            <TabItem Header="Settings" Padding="14,6">
                <ScrollViewer DataContext="{Binding Settings}" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
                    <Border Style="{StaticResource Card}" MaxWidth="760" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="How should WinShield respond to a threat?" Style="{StaticResource SectionTitle}" />
                            <ComboBox SelectedIndex="{Binding ResponseModeIndex, Mode=TwoWay}" Padding="8,6">
                                <ComboBoxItem Content="Monitor only (alerts, never acts)" />
                                <ComboBoxItem Content="Ask me first (recommended)" />
                                <ComboBoxItem Content="Contain automatically" />
                            </ComboBox>
                            <TextBlock Text="{Binding ResponseModeHelp}" Style="{StaticResource Hint}" Margin="0,6,0,12" />

                            <CheckBox Content="Cut this PC off from the network automatically on a critical threat"
                                      IsChecked="{Binding AutoIsolateOnCritical, Mode=TwoWay}" Margin="0,0,0,8" />
                            <CheckBox Content="Keep decoy files (honeypots) in protected folders"
                                      IsChecked="{Binding HoneypotsEnabled, Mode=TwoWay}" Margin="0,0,0,16" />

                            <TextBlock Text="Recovery points" Style="{StaticResource SectionTitle}" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding BackupFolder, UpdateSourceTrigger=PropertyChanged}" Padding="6,5" />
                                <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseBackupFolderCommand}"
                                        Style="{StaticResource ActionButton}" Margin="8,0,0,0" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Keep at most" VerticalAlignment="Center" />
                                <TextBox Text="{Binding MaxRecoveryPoints, UpdateSourceTrigger=LostFocus}" Width="50" Margin="8,0" Padding="4,3" />
                                <TextBlock Text="recovery points; make an automatic one every" VerticalAlignment="Center" />
                                <TextBox Text="{Binding AutoRecoveryPointHours, UpdateSourceTrigger=LostFocus}" Width="50" Margin="8,0" Padding="4,3" />
                                <TextBlock Text="hours (0 = off)" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                                       Text="Store recovery points on a different drive than the files they protect, ideally one that is not always connected." />

                            <WrapPanel>
                                <Button Content="Save settings" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" />
                                <Button Content="Open data folder" Command="{Binding OpenDataFolderCommand}" Style="{StaticResource ActionButton}"
                                        VerticalAlignment="Center" Margin="0,0,8,0" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource Hint}" FontWeight="SemiBold" Margin="0,8,0,0" />

                            <Separator Margin="0,16" />
                            <TextBlock Text="{Binding ModelStatus}" Style="{StaticResource Hint}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0">
                                <Run Text="Data folder: " /><Run Text="{Binding DataFolder, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                       Text="Detection thresholds and the trusted-programs list are in settings.json in the data folder." />
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
