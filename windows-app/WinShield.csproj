<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>WinShield</RootNamespace>
    <AssemblyName>WinShield</AssemblyName>
    <Version>2.0.0</Version>
    <!-- Note: SupportedOSPlatformVersion must not exceed the TFM's platform version (7.0 for net8.0-windows), or the build fails with NETSDK1135. -->

    <!-- asInvoker by default; the app offers 'Restart as administrator' for the features that need it. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>winshield.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test project has its own csproj; keep it out of the app build. -->
    <Compile Remove="tests\**" />
    <None Remove="tests\**" />
    <Page Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The WPF SDK removes the implicit System.IO import (it clashes with System.Windows.Shapes.Path); the services use plain file APIs. -->
    <Using Include="System.IO" />
    <Using Remove="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <Resource Include="winshield.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compiled into the .exe: the app no longer needs a Data folder next to it. -->
    <EmbeddedResource Include="Data\schema.sql" LogicalName="WinShield.schema.sql" />
  </ItemGroup>

</Project>
